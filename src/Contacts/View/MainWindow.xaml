<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.ViewModel" xmlns:Controls="clr-namespace:View.Controls" x:Class="Contacts.MainWindow"
        d:DataContext="{d:DesignInstance Type={x:Type local:MainVM}}"
        mc:Ignorable="d"
        Title="Contacts" Height="400" Width="500">
    <Grid  Margin="15px">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="31"></RowDefinition>
        </Grid.RowDefinitions>
        
        <GroupBox Header="Edit Contact" Grid.Column="0" Grid.Row="0" Margin="3px">
            <StackPanel>
                <Label Content="Name:" Height="26px" Margin="3px"/>
                <TextBox Margin="3px" Height="26px" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Phone Number:" Height="26px" Margin="3px"/>
                <TextBox Margin="3px" Height="26px" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Email:" Height="26px" Margin="3px"/>
                <TextBox Margin="3px" Height="26px" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Read Contact" Grid.Column="1" Grid.Row="0" Margin="3px">
            <StackPanel>
                <Label Content="Name:" Height="26px" Margin="3px"/>
                <TextBlock Margin="6, 3, 6, 3" Height="26px" Text="{Binding Path=Name}"/>
                <Label Content="Phone Number:" Height="26px" Margin="3px"/>
                <TextBlock Margin="6, 3, 6, 3" Height="26px" Text="{Binding Path=PhoneNumber}"/>
                <Label Content="Email:" Height="26px" Margin="3px"/>
                <TextBlock Margin="6, 3, 6, 3" Height="26px" Text="{Binding Path=Email}" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Grid.Column="1" Content="Save" 
                    Height="25px" Width="75px" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    HorizontalContentAlignment="Center"
                    Margin="3px"
                    Command="{Binding SaveCommand}"
                    />
            <Button Grid.Column="1" Content="Load" 
                    Height="25px" Width="75px" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    HorizontalContentAlignment="Center"
                    Margin="3px"
                    Command="{Binding LoadCommand}"
                    />
        </StackPanel>
    </Grid>
</Window>
