<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Contacts" Height="500" Width="770" MinHeight="500" MinWidth="770">
    <Window.Resources>
        <DataTemplate x:Key="contactTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="3" Grid.Column="1">
                    <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"/>
                    <TextBlock
                    FontSize="10"
                    Text="{Binding Phone}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="#f8f8f8">
        <Grid.Resources>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Width" Value="75"/>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Padding" Value="0,5,0,0"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="256"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter
            Grid.Column="1"
            ShowsPreview="False" 
            Width="3"
            Background="White"
            HorizontalAlignment="Center" 
            VerticalAlignment="Stretch" />
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="3">
                <Label Content="Find:" Width="40"/>
                <TextBox/>
            </DockPanel>
            <ListBox
                VerticalAlignment="Stretch"
                Grid.Row="1"
                Margin="3"
                ItemTemplate="{StaticResource contactTemplate}"/>
            <StackPanel Orientation="Horizontal" Grid.Row="2">
                <Button Content="Add"/>
                <Button
                    Content="Edit"/>
                <Button
                    Content="Remove"/>
            </StackPanel>
        </Grid>
        <Grid Background="White" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Margin="2,220,0,0" Grid.Column="1">
                <Button
                    Content="Apply"
                    HorizontalAlignment="Left"/>
                <Button
                    Content="Cancel"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>