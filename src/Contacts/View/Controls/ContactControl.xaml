<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls" xmlns:viewmodel="clr-namespace:View.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MainVM}"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="440">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image
            Width="100"
            Height="100"
            VerticalAlignment="Top"
            Margin="5,34"
            Source="/Resources/user.png"/>
        <StackPanel Margin="5" Grid.Column="1">
            <Label Content="Name:" Height="26"/>
            <TextBox
                Height="26"
                TextWrapping="Wrap"
                Text="{Binding EditContact.Name, UpdateSourceTrigger=PropertyChanged}"
                Margin="3"
                IsReadOnly="{Binding IsReadOnly}"/>
            <Label Content="Phone Number:" Height="26"/>
            <TextBox
                Height="26"
                TextWrapping="Wrap"
                Text="{Binding EditContact.Phone, UpdateSourceTrigger=PropertyChanged}"
                Margin="3"
                IsReadOnly="{Binding IsReadOnly}"/>
            <Label Content="Email:" Height="26"/>
            <TextBox
                Height="26"
                TextWrapping="Wrap"
                Text="{Binding EditContact.Email, UpdateSourceTrigger=PropertyChanged}"
                Margin="3"
                IsReadOnly="{Binding IsReadOnly}"/>
        </StackPanel>
    </Grid>
</UserControl>